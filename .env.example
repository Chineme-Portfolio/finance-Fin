# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# See context/security.md section 2. No Plaid value may ever carry a NEXT_PUBLIC_ prefix.

# From the Plaid dashboard. Server side only.
PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" while building the pipeline (free, unlimited).
# "production" only for the real observation run (spec 0001, task 9).
# The Production free Trial allows about ten Items and there is no budget for more.
PLAID_ENV=sandbox

# Required if an institution routes through Plaid's OAuth flow, which the brokerage and
# the recordkeeper likely do. Must be registered in the Plaid dashboard first.
PLAID_REDIRECT_URI=

# --- Supabase (spec 0004) ---
# From the Supabase project dashboard (Settings > API). See context/security.md §2.
# The URL and publishable/anon key are safe to expose (RLS-bound); the secret key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# The fixed development user id standing in for auth.uid() until real login lands
# (spec 0004). Any uuid; used to stamp/scope rows server-side for the single user.
DEV_USER_ID=
